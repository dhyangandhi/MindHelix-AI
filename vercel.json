{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "www/**",
        "utils/**",
        "*.html",
        "*.css",
        "*.jpg",
        "*.png",
        "*.svg",
        "*.js"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
